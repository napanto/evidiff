# Copy to .env (never commit it) and load it in the service environment.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_PATH=/var/lib/evidiff/app.sqlite3
BASE_URL=https://evidiff.example.org
CONTACT_EMAIL=
# Footer link to the source code (AGPL-3.0 section 13). Point it at your own
# repository if you run a modified version.
# SOURCE_URL=https://github.com/napanto/evidiff
# Compensation is off by default. A study database keeps the mode it was created
# with: it cannot be switched on or off later.
COMPENSATION_ENABLED=false
# Only read when COMPENSATION_ENABLED=true:
# PRICE_PER_PAIR_EUR=0.00
# FIXED_FEE_EUR=0.00
# BUDGET_CAP_EUR=0.00
# TARGET_HOURLY_EUR=0.00
PREVIEW_MODE=false
PRACTICE_ENABLED=true
# Required unless PREVIEW_MODE=true: the study package (JSONL, one pair per line,
# validated against content/package_item_schema.json).
PAIR_FILE=/var/lib/evidiff/pairs.jsonl
